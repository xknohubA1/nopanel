{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nopanel",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "5fca901b-88e7-4698-adee-ce4f046bdda2","database_name": "nopanel" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "cc3dba7ea7a043ff8909784a7ffd5777" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
